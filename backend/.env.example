# AI API Keys (at least one required for real AI features; optional for local deterministic mode)
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
GEMINI_API_KEY=AIza-your-key-here

# Server Config (Vercel serverless has a 4.5MB payload limit; keep <= 4MB for ₹0 tier)
UPLOAD_MAX_SIZE_MB=4
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://parul-study-assistant.vercel.app

# Durable Persistence — Neon PostgreSQL (use pooled -pooler connection string in production)
DATABASE_URL=postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Private Document Storage — Amazon S3 in Mumbai (ap-south-1)
AWS_S3_BUCKET=parul-study-assistant-private
AWS_S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIA-your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_PRESIGN_EXPIRY_SECONDS=900

# Durable Background Job Dispatch — Upstash QStash
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=qstash-token-here
QSTASH_CURRENT_SIGNING_KEY=sig_current_key_here
QSTASH_NEXT_SIGNING_KEY=sig_next_key_here
QSTASH_WEBHOOK_URL=https://your-backend.vercel.app/api/v1/jobs/webhook
